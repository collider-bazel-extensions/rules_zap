"""zap_distribution: the @zap repo's target (generated by repositories.bzl)."""

load(":providers.bzl", "ZapInfo")

def _zap_distribution_impl(ctx):
    if ctx.file.jar not in ctx.files.install:
        fail("zap_distribution: jar must be one of install")
    return [
        ZapInfo(
            version = ctx.attr.version,
            jar = ctx.file.jar,
            install = depset(ctx.files.install),
            addons = ctx.files.addons,
        ),
        DefaultInfo(files = depset(ctx.files.install + ctx.files.addons)),
    ]

zap_distribution = rule(
    implementation = _zap_distribution_impl,
    attrs = {
        "version": attr.string(mandatory = True),
        "jar": attr.label(allow_single_file = [".jar"], mandatory = True),
        "install": attr.label_list(allow_files = True, mandatory = True),
        "addons": attr.label_list(allow_files = [".zap"], mandatory = True),
    },
)
