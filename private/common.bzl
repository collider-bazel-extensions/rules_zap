"""Shared helpers: runfiles paths, shell quoting, the Java runtime."""

load("@rules_java//java/common:java_common.bzl", "java_common")

JavaRuntimeInfo = java_common.JavaRuntimeInfo

def rlocation(ctx, f):
    """The runfiles path of `f` (relative to the runfiles root)."""
    p = f.short_path
    if p.startswith("../"):
        return p[3:]
    return ctx.workspace_name + "/" + p

def java_rlocation(ctx, runtime):
    p = runtime.java_executable_runfiles_path
    if p.startswith("../"):
        return p[3:]
    return ctx.workspace_name + "/" + p

def shell_quote(s):
    return "'" + s.replace("'", "'\\''") + "'"

# The launcher every rules_zap executable uses: finds the runfiles tree,
# then runs the driver on the pinned JDK.
LAUNCHER = """\
#!/usr/bin/env bash
# Generated by rules_zap.
set -euo pipefail
if [[ -z "${{RUNFILES_DIR:-}}" ]]; then
    if [[ -n "${{TEST_SRCDIR:-}}" && -d "$TEST_SRCDIR" ]]; then
        RUNFILES_DIR="$TEST_SRCDIR"
    elif [[ -d "$0.runfiles" ]]; then
        RUNFILES_DIR="$(cd "$0.runfiles" && pwd)"
    else
        echo "rules_zap: can't find the runfiles tree for $0" >&2
        exit 2
    fi
fi
export RUNFILES_DIR
exec "$RUNFILES_DIR/"{java} -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xshare:auto \\
    -cp "$RUNFILES_DIR/"{driver} rules_zap.ZapScan {mode} --runfiles "$RUNFILES_DIR" {args} "$@"
"""

def launcher_content(ctx, runtime, driver, mode, args):
    return LAUNCHER.format(
        java = shell_quote(java_rlocation(ctx, runtime)),
        driver = shell_quote(rlocation(ctx, driver)),
        mode = mode,
        args = " \\\n    ".join([shell_quote(a) for a in args]),
    )
